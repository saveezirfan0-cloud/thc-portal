      "from": "open",
      "to": "withdrawn",
      "ref": "ADR-0039 the worker withdraws the offer (withdraw_shift_offer)"
    },
    {
      "from": "open",
      "to": "lapsed",
      "ref": "ADR-0039 expiry at start - 72 h (OF3), the booking leaving confirmed by any other cause, §1.7 GDPR"
    },
    {
      "from": "open",
      "to": "cancelled",
      "ref": "ADR-0039 the office declines a cover request (office_decline_cover); OF6"
    }
