        { "startsOn": "2026-11-20", "hours": 10, "canRoster": true },
        { "startsOn": "2026-11-21", "hours": 10, "canRoster": true }
      ],
      "context": { "capHours": 48, "band": "standard_48", "bookedHours": 0 },
      "mode": "warn",
      "expect": { "weeks": [{ "weekStart": "2026-11-16", "hours": 50 }], "blocked": false }
    },
    {
      "name": "no_ceiling_never_blocks",
      "days": [
        { "startsOn": "2026-11-20", "hours": 12, "canRoster": true },
        { "startsOn": "2026-11-21", "hours": 12, "canRoster": true },
        { "startsOn": "2026-11-22", "hours": 12, "canRoster": true }
      ],
      "context": { "capHours": null, "band": "uncapped", "bookedHours": 0 },
      "mode": "block",
      "expect": { "weeks": [{ "weekStart": "2026-11-16", "hours": 36 }], "blocked": false }
