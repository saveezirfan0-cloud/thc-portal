      "context": { "capHours": 20, "band": "student_term_20", "bookedHours": 14 },
      "mode": "block",
      "expect": {
        "weeks": [
          { "weekStart": "2026-11-16", "hours": 8 },
          { "weekStart": "2026-11-23", "hours": 8 }
        ],
        "blocked": true
      }
    },
    {
      "name": "standard_48_over_in_block_mode_blocks",
      "days": [
        { "startsOn": "2026-11-17", "hours": 10, "canRoster": true },
