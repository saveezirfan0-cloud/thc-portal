    },
    {
      "name": "standard_48_over_in_warn_mode_does_not_block",
      "days": [
        { "startsOn": "2026-11-17", "hours": 10, "canRoster": true },
        { "startsOn": "2026-11-18", "hours": 10, "canRoster": true },
