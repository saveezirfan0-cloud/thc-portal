      "context": { "capHours": 10, "band": "student_term_10", "bookedHours": 0 },
      "mode": "warn",
      "expect": { "weeks": [{ "weekStart": "2026-11-16", "hours": 16 }], "blocked": true }
    },
    {
      "name": "days_either_side_of_a_monday_are_two_weeks_each_judged_alone",
      "days": [
        { "startsOn": "2026-11-22", "hours": 8, "canRoster": true },
        { "startsOn": "2026-11-23", "hours": 8, "canRoster": true }
