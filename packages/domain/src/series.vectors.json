{
  "description": "ADR-0116 same staff on all days: the series' hours, projected over every flagged day together, against the weekly cap (RULE-20). `days` are the section being judged plus its flagged siblings; `bookedHours` is the rest of the worker's week WITHOUT those days. Run by packages/domain/src/__tests__/series.test.ts; supabase/tests/790_same_staff_all_days.sql builds the same scenarios by name against series_hours_blocked().",
  "cases": [
    {
      "name": "student_term_three_8h_days_in_one_week_blocked",
      "days": [
        { "startsOn": "2026-11-20", "hours": 8, "canRoster": true },
        { "startsOn": "2026-11-21", "hours": 8, "canRoster": true },
        { "startsOn": "2026-11-22", "hours": 8, "canRoster": true }
      ],
      "context": { "capHours": 20, "band": "student_term_20", "bookedHours": 0 },
      "mode": "block",
      "expect": { "weeks": [{ "weekStart": "2026-11-16", "hours": 24 }], "blocked": true }
    },
    {
      "name": "student_term_two_8h_days_fit",
      "days": [
        { "startsOn": "2026-11-21", "hours": 8, "canRoster": true },
        { "startsOn": "2026-11-22", "hours": 8, "canRoster": true }
      ],
      "context": { "capHours": 20, "band": "student_term_20", "bookedHours": 0 },
      "mode": "block",
      "expect": { "weeks": [{ "weekStart": "2026-11-16", "hours": 16 }], "blocked": false }
    },
    {
      "name": "student_term_exactly_the_cap_fits",
      "days": [
        { "startsOn": "2026-11-20", "hours": 7, "canRoster": true },
        { "startsOn": "2026-11-21", "hours": 7, "canRoster": true },
        { "startsOn": "2026-11-22", "hours": 6, "canRoster": true }
      ],
      "context": { "capHours": 20, "band": "student_term_20", "bookedHours": 0 },
      "mode": "block",
      "expect": { "weeks": [{ "weekStart": "2026-11-16", "hours": 20 }], "blocked": false }
    },
    {
      "name": "student_term_other_bookings_in_the_week_count",
      "days": [
        { "startsOn": "2026-11-21", "hours": 8, "canRoster": true },
        { "startsOn": "2026-11-22", "hours": 8, "canRoster": true }
      ],
      "context": { "capHours": 20, "band": "student_term_20", "bookedHours": 6 },
      "mode": "block",
      "expect": { "weeks": [{ "weekStart": "2026-11-16", "hours": 16 }], "blocked": true }
    },
    {
      "name": "below_degree_level_ten_hour_cap_blocks_two_8h_days",
      "days": [
        { "startsOn": "2026-11-21", "hours": 8, "canRoster": true },
        { "startsOn": "2026-11-22", "hours": 8, "canRoster": true }
