    {
      "name": "a_day_past_the_right_to_work_blocks_its_week",
      "days": [
        { "startsOn": "2026-11-20", "hours": 6, "canRoster": true },
        { "startsOn": "2026-11-21", "hours": 6, "canRoster": false }
      ],
      "context": { "capHours": 48, "band": "standard_48", "bookedHours": 0 },
      "mode": "warn",
      "expect": { "weeks": [{ "weekStart": "2026-11-16", "hours": 12 }], "blocked": true }
