        "venueId": "v2"
      },
      "held": {
        "startsAt": "2026-11-02T09:00",
        "endsAt": "2026-11-02T14:00",
        "venueId": "v1"
      },
      "gapMinutes": 120,
      "expect": "gap_too_short"
    },
    {
      "name": "Same venue, back-to-back with no gap — always fine",
      "candidate": {
        "startsAt": "2026-11-02T14:00",
        "endsAt": "2026-11-02T19:00",
        "venueId": "v1"
      },
      "held": {
        "startsAt": "2026-11-02T09:00",
        "endsAt": "2026-11-02T14:00",
        "venueId": "v1"
      },
      "gapMinutes": 120,
      "expect": "clear"
    },
    {
      "name": "Same venue, a ten-minute gap — still fine, no gap is required",
