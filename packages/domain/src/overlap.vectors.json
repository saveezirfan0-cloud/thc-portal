        "startsAt": "2026-11-02T14:10",
        "endsAt": "2026-11-02T19:00",
        "venueId": "v1"
      },
      "held": {
        "startsAt": "2026-11-02T09:00",
        "endsAt": "2026-11-02T14:00",
        "venueId": "v1"
      },
      "gapMinutes": 120,
      "expect": "clear"
    },
    {
