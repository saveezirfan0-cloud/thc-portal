// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ColumnChooser > has a stable dialog (snapshot) 1`] = `"<div id="ID-dialog" class="colchooser-pop" role="dialog" aria-modal="true" aria-labelledby="ID-title" tabindex="-1" style="--pop-top: 6px; --pop-right: 1024px;"><div class="colchooser-head"><div><h3 id="ID-title">Columns · Venues</h3><p class="xs muted">6 of 6 shown · drag, use the arrows or Alt+↑ / Alt+↓ to reorder</p></div><button type="button" class="btn ghost sm icon" aria-label="Close">×</button></div><ul class="colchooser-list" aria-label="Columns, in order"><li data-col-id="name" data-locked="" class="colchooser-row"><span class="colchooser-handle off" aria-hidden="true"><svg viewBox="0 0 10 16" width="10" height="16" focusable="false"><circle cx="2.5" cy="3" r="1.4"></circle><circle cx="7.5" cy="3" r="1.4"></circle><circle cx="2.5" cy="8" r="1.4"></circle><circle cx="7.5" cy="8" r="1.4"></circle><circle cx="2.5" cy="13" r="1.4"></circle><circle cx="7.5" cy="13" r="1.4"></circle></svg></span><div class="colchooser-check"><label class="check"><input class="check-input" disabled="" type="checkbox" checked=""><span class="box on" aria-hidden="true"></span><span>Venue<span class="sub">Always shown · first</span></span></label></div></li><li data-col-id="address" data-movable="" class="colchooser-row"><span class="colchooser-handle" aria-hidden="true" title="Drag to reorder"><svg viewBox="0 0 10 16" width="10" height="16" focusable="false"><circle cx="2.5" cy="3" r="1.4"></circle><circle cx="7.5" cy="3" r="1.4"></circle><circle cx="2.5" cy="8" r="1.4"></circle><circle cx="7.5" cy="8" r="1.4"></circle><circle cx="2.5" cy="13" r="1.4"></circle><circle cx="7.5" cy="13" r="1.4"></circle></svg></span><div class="colchooser-check"><label class="check"><input class="check-input" type="checkbox" checked=""><span class="box on" aria-hidden="true"></span><span>Address</span></label></div><span class="colchooser-moves"><button type="button" class="btn ghost sm icon" data-ctl="up" aria-label="Move Address up" disabled="">↑</button><button type="button" class="btn ghost sm icon" data-ctl="down" aria-label="Move Address down">↓</button></span></li><li data-col-id="type" data-movable="" class="colchooser-row"><span class="colchooser-handle" aria-hidden="true" title="Drag to reorder"><svg viewBox="0 0 10 16" width="10" height="16" focusable="false"><circle cx="2.5" cy="3" r="1.4"></circle><circle cx="7.5" cy="3" r="1.4"></circle><circle cx="2.5" cy="8" r="1.4"></circle><circle cx="7.5" cy="8" r="1.4"></circle><circle cx="2.5" cy="13" r="1.4"></circle><circle cx="7.5" cy="13" r="1.4"></circle></svg></span><div class="colchooser-check"><label class="check"><input class="check-input" type="checkbox" checked=""><span class="box on" aria-hidden="true"></span><span>Type</span></label></div><span class="colchooser-moves"><button type="button" class="btn ghost sm icon" data-ctl="up" aria-label="Move Type up">↑</button><button type="button" class="btn ghost sm icon" data-ctl="down" aria-label="Move Type down">↓</button></span></li><li data-col-id="radius" data-movable="" class="colchooser-row"><span class="colchooser-handle" aria-hidden="true" title="Drag to reorder"><svg viewBox="0 0 10 16" width="10" height="16" focusable="false"><circle cx="2.5" cy="3" r="1.4"></circle><circle cx="7.5" cy="3" r="1.4"></circle><circle cx="2.5" cy="8" r="1.4"></circle><circle cx="7.5" cy="8" r="1.4"></circle><circle cx="2.5" cy="13" r="1.4"></circle><circle cx="7.5" cy="13" r="1.4"></circle></svg></span><div class="colchooser-check"><label class="check"><input class="check-input" type="checkbox" checked=""><span class="box on" aria-hidden="true"></span><span>Geofence (m)</span></label></div><span class="colchooser-moves"><button type="button" class="btn ghost sm icon" data-ctl="up" aria-label="Move Geofence (m) up">↑</button><button type="button" class="btn ghost sm icon" data-ctl="down" aria-label="Move Geofence (m) down">↓</button></span></li><li data-col-id="margin" data-movable="" class="colchooser-row"><span class="colchooser-handle" aria-hidden="true" title="Drag to reorder"><svg viewBox="0 0 10 16" width="10" height="16" focusable="false"><circle cx="2.5" cy="3" r="1.4"></circle><circle cx="7.5" cy="3" r="1.4"></circle><circle cx="2.5" cy="8" r="1.4"></circle><circle cx="7.5" cy="8" r="1.4"></circle><circle cx="2.5" cy="13" r="1.4"></circle><circle cx="7.5" cy="13" r="1.4"></circle></svg></span><div class="colchooser-check"><label class="check"><input class="check-input" type="checkbox" checked=""><span class="box on" aria-hidden="true"></span><span>Avg margin</span></label></div><span class="colchooser-moves"><button type="button" class="btn ghost sm icon" data-ctl="up" aria-label="Move Avg margin up">↑</button><button type="button" class="btn ghost sm icon" data-ctl="down" aria-label="Move Avg margin down" disabled="">↓</button></span></li><li data-col-id="actions" data-locked="" class="colchooser-row"><span class="colchooser-handle off" aria-hidden="true"><svg viewBox="0 0 10 16" width="10" height="16" focusable="false"><circle cx="2.5" cy="3" r="1.4"></circle><circle cx="7.5" cy="3" r="1.4"></circle><circle cx="2.5" cy="8" r="1.4"></circle><circle cx="7.5" cy="8" r="1.4"></circle><circle cx="2.5" cy="13" r="1.4"></circle><circle cx="7.5" cy="13" r="1.4"></circle></svg></span><div class="colchooser-check"><label class="check"><input class="check-input" disabled="" type="checkbox" checked=""><span class="box on" aria-hidden="true"></span><span>Actions<span class="sub">Always shown · last</span></span></label></div></li></ul><div class="colchooser-foot"><button type="button" class="btn ghost sm" disabled="">Reset to default</button><button type="button" class="btn primary sm">Done</button></div></div>"`;
