    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf /*)",
      "Read(./.env*)",
      "Read(./apps/*/.env*)"
    ]
  },
  "env": {
    "APP_TZ": "Europe/London"
  }
