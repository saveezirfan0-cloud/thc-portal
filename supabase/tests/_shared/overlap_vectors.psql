  ('Same venue but the windows genuinely intersect — nobody can work both', '{"candidate":{"startsAt":"2026-11-02T13:00","endsAt":"2026-11-02T19:00","venueId":"v1"},"held":{"startsAt":"2026-11-02T09:00","endsAt":"2026-11-02T14:00","venueId":"v1"},"gapMinutes":120}'::jsonb, 'intersects'),
  ('Different venues and the windows intersect', '{"candidate":{"startsAt":"2026-11-02T13:00","endsAt":"2026-11-02T19:00","venueId":"v2"},"held":{"startsAt":"2026-11-02T09:00","endsAt":"2026-11-02T14:00","venueId":"v1"},"gapMinutes":120}'::jsonb, 'intersects'),
  ('The candidate is the EARLIER of the two — order must not matter', '{"candidate":{"startsAt":"2026-11-02T09:00","endsAt":"2026-11-02T14:00","venueId":"v1"},"held":{"startsAt":"2026-11-02T18:00","endsAt":"2026-11-02T23:00","venueId":"v2"},"gapMinutes":120}'::jsonb, 'clear'),
  ('The candidate is earlier and the gap is short', '{"candidate":{"startsAt":"2026-11-02T09:00","endsAt":"2026-11-02T14:00","venueId":"v1"},"held":{"startsAt":"2026-11-02T15:00","endsAt":"2026-11-02T23:00","venueId":"v2"},"gapMinutes":120}'::jsonb, 'gap_too_short'),
  ('An identical window at the same venue is an intersection, not a back-to-back', '{"candidate":{"startsAt":"2026-11-02T09:00","endsAt":"2026-11-02T14:00","venueId":"v1"},"held":{"startsAt":"2026-11-02T09:00","endsAt":"2026-11-02T14:00","venueId":"v1"},"gapMinutes":120}'::jsonb, 'intersects'),
