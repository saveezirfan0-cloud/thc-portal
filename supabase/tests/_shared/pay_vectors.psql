  ('a check-out on the check-in timestamp is undetermined, not a zero-length shift', '{"shiftMin":480,"checkInMinFromStart":60,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":60}'::jsonb, '{"status":"undetermined","payableMin":null,"workedMin":null,"floorApplied":false,"lateCheckOutFlag":false,"overrunMin":null}'::jsonb),
