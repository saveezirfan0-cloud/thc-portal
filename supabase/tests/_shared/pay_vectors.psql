  ('a check-in past the end of the role section intersects nothing', '{"shiftMin":480,"checkInMinFromStart":510,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":540}'::jsonb, '{"status":"undetermined","payableMin":null,"workedMin":null,"floorApplied":false,"lateCheckOutFlag":false,"overrunMin":null}'::jsonb),
  ('one worked minute still floors: the empty-window guard must not swallow RULE-14', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":1}'::jsonb, '{"status":"settled","payableMin":240,"workedMin":1,"floorApplied":true,"lateCheckOutFlag":false,"overrunMin":0}'::jsonb),
  ('16:10 on a 16:00 end is paid and charged to 16:00 (ADR-0184)', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":490}'::jsonb, '{"status":"settled","payableMin":480,"workedMin":480,"floorApplied":false,"lateCheckOutFlag":false,"overrunMin":0}'::jsonb),
  ('one minute past the grace is paid to the actual finish (ADR-0184)', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":496}'::jsonb, '{"status":"settled","payableMin":496,"workedMin":496,"floorApplied":false,"lateCheckOutFlag":true,"overrunMin":16}'::jsonb),
  ('17:15 on a 16:00 end is paid to 17:15: 75 minutes overrun (ADR-0184)', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":555}'::jsonb, '{"status":"settled","payableMin":555,"workedMin":555,"floorApplied":false,"lateCheckOutFlag":true,"overrunMin":75}'::jsonb),
  ('a late arrival who overruns is paid from the arrival to the actual finish', '{"shiftMin":480,"checkInMinFromStart":20,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":555}'::jsonb, '{"status":"settled","payableMin":535,"workedMin":535,"floorApplied":false,"lateCheckOutFlag":true,"overrunMin":75}'::jsonb),
  ('unpaid breaks come off the main part, never the overrun', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":30,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":555}'::jsonb, '{"status":"settled","payableMin":525,"workedMin":525,"floorApplied":false,"lateCheckOutFlag":true,"overrunMin":75}'::jsonb),
  ('breaks longer than the main part eat into the overrun only for the excess', '{"shiftMin":240,"checkInMinFromStart":0,"unpaidBreakMin":270,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":300}'::jsonb, '{"status":"settled","payableMin":240,"workedMin":30,"floorApplied":true,"lateCheckOutFlag":true,"overrunMin":30}'::jsonb),
  ('a manager-entered finish past the grace is paid to it (resolved No check-out)', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"resolved","checkOutMinFromStart":600}'::jsonb, '{"status":"settled","payableMin":600,"workedMin":600,"floorApplied":false,"lateCheckOutFlag":true,"overrunMin":120}'::jsonb),
