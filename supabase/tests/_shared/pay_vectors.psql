  ('a section ending before 21.10.2026 (UK) is still paid to its scheduled end', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","startsAt":"2026-10-20T14:59:00Z","checkOutMinFromStart":555}'::jsonb, '{"status":"settled","payableMin":480,"workedMin":480,"floorApplied":false,"lateCheckOutFlag":true,"overrunMin":0}'::jsonb),
  ('a section ending at 00:00 UK on 21.10.2026 is paid to the actual finish', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","startsAt":"2026-10-20T15:00:00Z","checkOutMinFromStart":555}'::jsonb, '{"status":"settled","payableMin":555,"workedMin":555,"floorApplied":false,"lateCheckOutFlag":true,"overrunMin":75}'::jsonb);

create temporary table vec_turn_away (name text, input jsonb, expect jsonb) on commit drop;
insert into vec_turn_away (name, input, expect) values
  ('on time is a fixed four hours', '{"shiftMin":480,"attemptMinFromStart":10}'::jsonb, '{"payMin":240}'::jsonb),
  ('the last minute of the grace is still on time', '{"shiftMin":480,"attemptMinFromStart":29}'::jsonb, '{"payMin":240}'::jsonb),
  ('at start+30 the grace has elapsed and nothing is paid', '{"shiftMin":480,"attemptMinFromStart":30}'::jsonb, '{"payMin":0}'::jsonb),
  ('late is paid nothing', '{"shiftMin":480,"attemptMinFromStart":45}'::jsonb, '{"payMin":0}'::jsonb),
  ('arriving before the start is on time', '{"shiftMin":480,"attemptMinFromStart":-20}'::jsonb, '{"payMin":240}'::jsonb),
  ('four hours flat on a ten-hour shift', '{"shiftMin":600,"attemptMinFromStart":0}'::jsonb, '{"payMin":240}'::jsonb);

create temporary table vec_breaks (name text, input jsonb, expect jsonb) on commit drop;
insert into vec_breaks (name, input, expect) values
  ('a break inside the window is deducted in full', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":480,"breaks":[[180,200]]}'::jsonb, '{"unpaidBreakMin":20}'::jsonb),
  ('several breaks are summed', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":480,"breaks":[[120,140],[300,315]]}'::jsonb, '{"unpaidBreakMin":35}'::jsonb),
  ('a break before the scheduled start costs nothing', '{"shiftMin":480,"checkInMinFromStart":-30,"finishMinFromStart":480,"breaks":[[-25,-10]]}'::jsonb, '{"unpaidBreakMin":0}'::jsonb),
  ('a break straddling the start is clipped to the start', '{"shiftMin":480,"checkInMinFromStart":-30,"finishMinFromStart":480,"breaks":[[-10,10]]}'::jsonb, '{"unpaidBreakMin":10}'::jsonb),
  ('a break before a late check-in costs nothing past it', '{"shiftMin":480,"checkInMinFromStart":45,"finishMinFromStart":480,"breaks":[[40,60]]}'::jsonb, '{"unpaidBreakMin":15}'::jsonb),
  ('a break after the scheduled end costs nothing inside the 15-minute grace', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":495,"breaks":[[482,490]]}'::jsonb, '{"unpaidBreakMin":0}'::jsonb),
  ('a break during a paid overrun is deducted (ADR-0184)', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":540,"breaks":[[490,520]]}'::jsonb, '{"unpaidBreakMin":30}'::jsonb),
  ('a break straddling the end is clipped to the end inside the grace', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":495,"breaks":[[470,490]]}'::jsonb, '{"unpaidBreakMin":10}'::jsonb),
  ('a break straddling the end of an overrun shift is deducted in full', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":540,"breaks":[[470,500]]}'::jsonb, '{"unpaidBreakMin":30}'::jsonb),
  ('a break still running ends at the finish', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":300,"breaks":[[280,null]]}'::jsonb, '{"unpaidBreakMin":20}'::jsonb),
  ('a break still running is clipped to the end inside the grace', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":490,"breaks":[[460,null]]}'::jsonb, '{"unpaidBreakMin":20}'::jsonb),
  ('a break still running at a late finish runs to that finish (ADR-0184)', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":600,"breaks":[[460,null]]}'::jsonb, '{"unpaidBreakMin":140}'::jsonb),
  ('a break past an early finish costs nothing', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":200,"breaks":[[210,230]]}'::jsonb, '{"unpaidBreakMin":0}'::jsonb),
  ('no breaks, nothing deducted', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":480,"breaks":[]}'::jsonb, '{"unpaidBreakMin":0}'::jsonb),
  ('a break after the end of a section before 21.10.2026 (UK) costs nothing', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":540,"startsAt":"2026-10-20T14:59:00Z","breaks":[[490,520]]}'::jsonb, '{"unpaidBreakMin":0}'::jsonb),
  ('a break past end + 4 h costs nothing: it was never paid (ADR-0184)', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":840,"breaks":[[700,740],[760,790]]}'::jsonb, '{"unpaidBreakMin":20}'::jsonb);
