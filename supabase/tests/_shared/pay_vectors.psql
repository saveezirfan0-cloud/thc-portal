  ('a short shift is lifted to the four-hour floor (RULE-14)', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":120}'::jsonb, '{"status":"settled","payableMin":240,"workedMin":120,"floorApplied":true,"lateCheckOutFlag":false}'::jsonb),
  ('a Left early violation blocks the floor, resolved or not', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":true,"noCheckOut":"none","checkOutMinFromStart":120}'::jsonb, '{"status":"settled","payableMin":120,"workedMin":120,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('an unresolved No check-out blocks the floor', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"unresolved","checkOutMinFromStart":120}'::jsonb, '{"status":"settled","payableMin":120,"workedMin":120,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('resolving the No check-out restores the floor', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"resolved","checkOutMinFromStart":120}'::jsonb, '{"status":"settled","payableMin":240,"workedMin":120,"floorApplied":true,"lateCheckOutFlag":false}'::jsonb),
