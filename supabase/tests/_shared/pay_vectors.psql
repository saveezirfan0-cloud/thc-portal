  ('a late worker on a short shift is still floored to four hours (RULE-14)', '{"shiftMin":240,"checkInMinFromStart":20,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":240}'::jsonb, '{"status":"settled","payableMin":240,"workedMin":220,"floorApplied":true,"lateCheckOutFlag":false,"overrunMin":0}'::jsonb),
  ('past the grace (manager Get back) is paid from the actual arrival', '{"shiftMin":480,"checkInMinFromStart":45,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":480}'::jsonb, '{"status":"settled","payableMin":435,"workedMin":435,"floorApplied":false,"lateCheckOutFlag":false,"overrunMin":0}'::jsonb),
  ('leaving early is deducted', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":420}'::jsonb, '{"status":"settled","payableMin":420,"workedMin":420,"floorApplied":false,"lateCheckOutFlag":false,"overrunMin":0}'::jsonb),
  ('the 15-minute check-out grace pays to the scheduled end, not the press', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":495}'::jsonb, '{"status":"settled","payableMin":480,"workedMin":480,"floorApplied":false,"lateCheckOutFlag":false,"overrunMin":0}'::jsonb),
  ('past 15 minutes it is paid to the actual finish and flagged (ADR-0184)', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":500}'::jsonb, '{"status":"settled","payableMin":500,"workedMin":500,"floorApplied":false,"lateCheckOutFlag":true,"overrunMin":20}'::jsonb),
  ('three hours late is paid to the actual finish, all three hours overrun (ADR-0184)', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":660}'::jsonb, '{"status":"settled","payableMin":660,"workedMin":660,"floorApplied":false,"lateCheckOutFlag":true,"overrunMin":180}'::jsonb),
  ('unpaid breaks are deducted (§5.2b)', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":20,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":480}'::jsonb, '{"status":"settled","payableMin":460,"workedMin":460,"floorApplied":false,"lateCheckOutFlag":false,"overrunMin":0}'::jsonb),
  ('no check-out and no manager finish time leaves the pay undetermined', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":null}'::jsonb, '{"status":"undetermined","payableMin":null,"workedMin":null,"floorApplied":false,"lateCheckOutFlag":false,"overrunMin":null}'::jsonb),
  ('the manager-entered finish time settles it (RULE-02)', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"resolved","checkOutMinFromStart":450}'::jsonb, '{"status":"settled","payableMin":450,"workedMin":450,"floorApplied":false,"lateCheckOutFlag":false,"overrunMin":0}'::jsonb),
  ('a short shift is lifted to the four-hour floor (RULE-14)', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":120}'::jsonb, '{"status":"settled","payableMin":240,"workedMin":120,"floorApplied":true,"lateCheckOutFlag":false,"overrunMin":0}'::jsonb),
