  ('off site is open right up to four hours after the end', '{"shiftMin":480,"insideGeofence":false,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":480,"atMinFromStart":719}'::jsonb, '{"decision":"recorded_last_on_site","recordedMinFromStart":480,"violation":"none","messageKey":"checked_out_off_site"}'::jsonb),
  ('off site with no on-site fix after check-in raises the violation on the press', '{"shiftMin":480,"insideGeofence":false,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":null,"atMinFromStart":600}'::jsonb, '{"decision":"no_on_site_fix","recordedMinFromStart":-8,"violation":"no_checkout","messageKey":"no_check_out_office_confirms"}'::jsonb),
