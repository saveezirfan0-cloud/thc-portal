  ('out of radius disables check-in, and the attempt is still logged', '{"shiftMin":480,"insideGeofence":false,"confirmedMinFromStart":-1440,"slotsFilled":0,"headcount":6,"strictBuffer":true,"atMinFromStart":-5}'::jsonb, '{"decision":"out_of_radius","accepted":false,"logOutcome":"out_of_radius","late":false,"minutesLate":0,"turnAwayPayMin":null,"messageKey":"out_of_radius"}'::jsonb),
  ('on the stroke of the start is on time, not Late', '{"shiftMin":480,"insideGeofence":true,"confirmedMinFromStart":-1440,"slotsFilled":0,"headcount":6,"strictBuffer":true,"atMinFromStart":0}'::jsonb, '{"decision":"checked_in","accepted":true,"logOutcome":"checked_in","late":false,"minutesLate":0,"turnAwayPayMin":null,"messageKey":"checked_in"}'::jsonb),
  ('30 minutes of grace counts as Late, with the minutes from the actual press', '{"shiftMin":480,"insideGeofence":true,"confirmedMinFromStart":-1440,"slotsFilled":0,"headcount":6,"strictBuffer":true,"atMinFromStart":20}'::jsonb, '{"decision":"checked_in_late","accepted":true,"logOutcome":"checked_in","late":true,"minutesLate":20,"turnAwayPayMin":null,"messageKey":"checked_in_late"}'::jsonb),
  ('the last minute of the grace is still Late, not a No-show', '{"shiftMin":480,"insideGeofence":true,"confirmedMinFromStart":-1440,"slotsFilled":0,"headcount":6,"strictBuffer":true,"atMinFromStart":29}'::jsonb, '{"decision":"checked_in_late","accepted":true,"logOutcome":"checked_in","late":true,"minutesLate":29,"turnAwayPayMin":null,"messageKey":"checked_in_late"}'::jsonb),
  ('at start+30 the grace has elapsed: automatic No-show and the button locks', '{"shiftMin":480,"insideGeofence":true,"confirmedMinFromStart":-1440,"slotsFilled":0,"headcount":6,"strictBuffer":true,"atMinFromStart":30}'::jsonb, '{"decision":"locked","accepted":false,"logOutcome":null,"late":true,"minutesLate":30,"turnAwayPayMin":null,"messageKey":"no_show_locked"}'::jsonb),
  ('well past the grace the button is still locked', '{"shiftMin":480,"insideGeofence":true,"confirmedMinFromStart":-1440,"slotsFilled":0,"headcount":6,"strictBuffer":true,"atMinFromStart":75}'::jsonb, '{"decision":"locked","accepted":false,"logOutcome":null,"late":true,"minutesLate":75,"turnAwayPayMin":null,"messageKey":"no_show_locked"}'::jsonb),
  ('a booking confirmed after the shift started is exempt from the lock', '{"shiftMin":480,"insideGeofence":true,"confirmedMinFromStart":60,"slotsFilled":0,"headcount":6,"strictBuffer":true,"atMinFromStart":120}'::jsonb, '{"decision":"checked_in_late","accepted":true,"logOutcome":"checked_in","late":true,"minutesLate":120,"turnAwayPayMin":null,"messageKey":"checked_in_late"}'::jsonb),
  ('a booking confirmed exactly at the start is not exempt', '{"shiftMin":480,"insideGeofence":true,"confirmedMinFromStart":0,"slotsFilled":0,"headcount":6,"strictBuffer":true,"atMinFromStart":40}'::jsonb, '{"decision":"locked","accepted":false,"logOutcome":null,"late":true,"minutesLate":40,"turnAwayPayMin":null,"messageKey":"no_show_locked"}'::jsonb),
  ('the exemption ends with the shift itself', '{"shiftMin":480,"insideGeofence":true,"confirmedMinFromStart":60,"slotsFilled":0,"headcount":6,"strictBuffer":true,"atMinFromStart":481}'::jsonb, '{"decision":"locked","accepted":false,"logOutcome":null,"late":true,"minutesLate":481,"turnAwayPayMin":null,"messageKey":"no_show_locked"}'::jsonb),
  ('the last check-in inside the headcount works', '{"shiftMin":480,"insideGeofence":true,"confirmedMinFromStart":-1440,"slotsFilled":5,"headcount":6,"strictBuffer":true,"atMinFromStart":5}'::jsonb, '{"decision":"checked_in_late","accepted":true,"logOutcome":"checked_in","late":true,"minutesLate":5,"turnAwayPayMin":null,"messageKey":"checked_in_late"}'::jsonb),
  ('past the headcount a strict-buffer worker is turned away, 4 hours if on time', '{"shiftMin":480,"insideGeofence":true,"confirmedMinFromStart":-1440,"slotsFilled":6,"headcount":6,"strictBuffer":true,"atMinFromStart":10}'::jsonb, '{"decision":"turned_away","accepted":false,"logOutcome":"turned_away","late":true,"minutesLate":10,"turnAwayPayMin":240,"messageKey":"turned_away_paid"}'::jsonb),
  ('a turn-away who was themselves late is paid nothing (RULE-15)', '{"shiftMin":480,"insideGeofence":true,"confirmedMinFromStart":-1440,"slotsFilled":6,"headcount":6,"strictBuffer":true,"atMinFromStart":45}'::jsonb, '{"decision":"turned_away","accepted":false,"logOutcome":"turned_away","late":true,"minutesLate":45,"turnAwayPayMin":0,"messageKey":"turned_away_unpaid"}'::jsonb),
  ('a client that pays the buffer turns nobody away', '{"shiftMin":480,"insideGeofence":true,"confirmedMinFromStart":-1440,"slotsFilled":7,"headcount":6,"strictBuffer":false,"atMinFromStart":10}'::jsonb, '{"decision":"checked_in_late","accepted":true,"logOutcome":"checked_in","late":true,"minutesLate":10,"turnAwayPayMin":null,"messageKey":"checked_in_late"}'::jsonb),
  ('a full shift does not turn away someone who is off site — they see the distance first', '{"shiftMin":480,"insideGeofence":false,"confirmedMinFromStart":-1440,"slotsFilled":6,"headcount":6,"strictBuffer":true,"atMinFromStart":10}'::jsonb, '{"decision":"out_of_radius","accepted":false,"logOutcome":"out_of_radius","late":true,"minutesLate":10,"turnAwayPayMin":null,"messageKey":"out_of_radius"}'::jsonb);

create temporary table vec_check_out (name text, input jsonb, expect jsonb) on commit drop;
insert into vec_check_out (name, input, expect) values
  ('check-out is not available before the shift has started', '{"shiftMin":480,"insideGeofence":true,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":null,"atMinFromStart":-5}'::jsonb, '{"decision":"not_started","recordedMinFromStart":null,"violation":"none","messageKey":"check_out_not_open","leftEarly":false}'::jsonb),
  ('on site records the moment the button was pressed', '{"shiftMin":480,"insideGeofence":true,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":null,"atMinFromStart":480}'::jsonb, '{"decision":"recorded_on_site","recordedMinFromStart":480,"violation":"none","messageKey":"checked_out","leftEarly":false}'::jsonb),
  ('checking out early is allowed and records the press', '{"shiftMin":480,"insideGeofence":true,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":null,"atMinFromStart":300}'::jsonb, '{"decision":"recorded_on_site","recordedMinFromStart":300,"violation":"none","messageKey":"checked_out","leftEarly":true}'::jsonb),
  ('off site records the last on-site fix, not the press (left 16:00, pressed 21:00) — and a fix that old is reviewed', '{"shiftMin":480,"insideGeofence":false,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":420,"atMinFromStart":660}'::jsonb, '{"decision":"recorded_last_on_site","recordedMinFromStart":420,"violation":"no_checkout","messageKey":"checked_out_off_site","leftEarly":false}'::jsonb),
  ('off site is open right up to four hours after the end', '{"shiftMin":480,"insideGeofence":false,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":480,"atMinFromStart":719}'::jsonb, '{"decision":"recorded_last_on_site","recordedMinFromStart":480,"violation":"none","messageKey":"checked_out_off_site","leftEarly":false}'::jsonb),
  ('off site with no on-site fix after check-in raises the violation on the press', '{"shiftMin":480,"insideGeofence":false,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":null,"atMinFromStart":600}'::jsonb, '{"decision":"no_on_site_fix","recordedMinFromStart":-8,"violation":"no_checkout","messageKey":"no_check_out_office_confirms","leftEarly":false}'::jsonb),
  ('at four hours past the end the button locks and RULE-02 takes over', '{"shiftMin":480,"insideGeofence":true,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":null,"atMinFromStart":720}'::jsonb, '{"decision":"locked","recordedMinFromStart":null,"violation":"no_checkout","messageKey":"no_check_out_locked","leftEarly":false}'::jsonb),
  ('the lock does not care whether the worker is on site', '{"shiftMin":480,"insideGeofence":false,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":480,"atMinFromStart":900}'::jsonb, '{"decision":"locked","recordedMinFromStart":null,"violation":"no_checkout","messageKey":"no_check_out_locked","leftEarly":false}'::jsonb),
  ('checking out on site 15 minutes before the end is not Left early', '{"shiftMin":480,"insideGeofence":true,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":null,"atMinFromStart":465}'::jsonb, '{"decision":"recorded_on_site","recordedMinFromStart":465,"violation":"none","messageKey":"checked_out","leftEarly":false}'::jsonb),
  ('checking out on site 16 minutes before the end is Left early', '{"shiftMin":480,"insideGeofence":true,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":null,"atMinFromStart":464}'::jsonb, '{"decision":"recorded_on_site","recordedMinFromStart":464,"violation":"none","messageKey":"checked_out","leftEarly":true}'::jsonb),
  ('a 14:00-22:00 shift checked out on site at 15:00 is Left early (audit D5)', '{"shiftMin":480,"insideGeofence":true,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":null,"atMinFromStart":60}'::jsonb, '{"decision":"recorded_on_site","recordedMinFromStart":60,"violation":"none","messageKey":"checked_out","leftEarly":true}'::jsonb),
  ('an off-site press before the end is Left early too', '{"shiftMin":480,"insideGeofence":false,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":290,"atMinFromStart":300}'::jsonb, '{"decision":"recorded_last_on_site","recordedMinFromStart":290,"violation":"none","messageKey":"checked_out_off_site","leftEarly":true}'::jsonb),
  ('a fix taken just after check-in and a press hours later is reviewed (audit D15)', '{"shiftMin":480,"insideGeofence":false,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":-7,"atMinFromStart":470}'::jsonb, '{"decision":"recorded_last_on_site","recordedMinFromStart":-7,"violation":"no_checkout","messageKey":"checked_out_off_site","leftEarly":false}'::jsonb),
  ('a fix 30 minutes before the press is not stale', '{"shiftMin":480,"insideGeofence":false,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":370,"atMinFromStart":400}'::jsonb, '{"decision":"recorded_last_on_site","recordedMinFromStart":370,"violation":"none","messageKey":"checked_out_off_site","leftEarly":true}'::jsonb),
  ('a fix within 30 minutes of the end is not stale, however late the press', '{"shiftMin":480,"insideGeofence":false,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":450,"atMinFromStart":700}'::jsonb, '{"decision":"recorded_last_on_site","recordedMinFromStart":450,"violation":"none","messageKey":"checked_out_off_site","leftEarly":false}'::jsonb),
  ('a fix 31 minutes before both the press and the end is stale', '{"shiftMin":480,"insideGeofence":false,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":449,"atMinFromStart":480}'::jsonb, '{"decision":"recorded_last_on_site","recordedMinFromStart":449,"violation":"no_checkout","messageKey":"checked_out_off_site","leftEarly":false}'::jsonb),
  ('off site with no fix, pressed early, is both No check-out and Left early', '{"shiftMin":480,"insideGeofence":false,"checkInMinFromStart":-8,"lastOnSiteMinFromStart":null,"atMinFromStart":120}'::jsonb, '{"decision":"no_on_site_fix","recordedMinFromStart":-8,"violation":"no_checkout","messageKey":"no_check_out_office_confirms","leftEarly":true}'::jsonb);

create temporary table vec_pay (name text, input jsonb, expect jsonb) on commit drop;
insert into vec_pay (name, input, expect) values
  ('arriving early is not paid', '{"shiftMin":480,"checkInMinFromStart":-30,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":480}'::jsonb, '{"status":"settled","payableMin":480,"workedMin":480,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('inside the 30-minute grace is paid from the scheduled start', '{"shiftMin":480,"checkInMinFromStart":20,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":480}'::jsonb, '{"status":"settled","payableMin":480,"workedMin":480,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('past the grace is paid from the actual arrival', '{"shiftMin":480,"checkInMinFromStart":45,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":480}'::jsonb, '{"status":"settled","payableMin":435,"workedMin":435,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('leaving early is deducted', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":420}'::jsonb, '{"status":"settled","payableMin":420,"workedMin":420,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('the 15-minute check-out grace pays to the scheduled end, not the press', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":495}'::jsonb, '{"status":"settled","payableMin":480,"workedMin":480,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('past 15 minutes the monitor flags it and the money is unchanged', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":500}'::jsonb, '{"status":"settled","payableMin":480,"workedMin":480,"floorApplied":false,"lateCheckOutFlag":true}'::jsonb),
  ('three hours late still pays only to the scheduled end', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":660}'::jsonb, '{"status":"settled","payableMin":480,"workedMin":480,"floorApplied":false,"lateCheckOutFlag":true}'::jsonb),
  ('unpaid breaks are deducted (§5.2b)', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":20,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":480}'::jsonb, '{"status":"settled","payableMin":460,"workedMin":460,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('no check-out and no manager finish time leaves the pay undetermined', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":null}'::jsonb, '{"status":"undetermined","payableMin":null,"workedMin":null,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('the manager-entered finish time settles it (RULE-02)', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"resolved","checkOutMinFromStart":450}'::jsonb, '{"status":"settled","payableMin":450,"workedMin":450,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('a short shift is lifted to the four-hour floor (RULE-14)', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":120}'::jsonb, '{"status":"settled","payableMin":240,"workedMin":120,"floorApplied":true,"lateCheckOutFlag":false}'::jsonb),
  ('a Left early violation blocks the floor, resolved or not', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":true,"noCheckOut":"none","checkOutMinFromStart":120}'::jsonb, '{"status":"settled","payableMin":120,"workedMin":120,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('an unresolved No check-out blocks the floor', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"unresolved","checkOutMinFromStart":120}'::jsonb, '{"status":"settled","payableMin":120,"workedMin":120,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('resolving the No check-out restores the floor', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"resolved","checkOutMinFromStart":120}'::jsonb, '{"status":"settled","payableMin":240,"workedMin":120,"floorApplied":true,"lateCheckOutFlag":false}'::jsonb),
  ('the floor never inflates a shift already over four hours', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":480}'::jsonb, '{"status":"settled","payableMin":480,"workedMin":480,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('breaks can bring a shift under the floor, and the floor still applies', '{"shiftMin":300,"checkInMinFromStart":0,"unpaidBreakMin":90,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":300}'::jsonb, '{"status":"settled","payableMin":240,"workedMin":210,"floorApplied":true,"lateCheckOutFlag":false}'::jsonb),
  ('a check-out on the check-in timestamp is undetermined, not a zero-length shift', '{"shiftMin":480,"checkInMinFromStart":60,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":60}'::jsonb, '{"status":"undetermined","payableMin":null,"workedMin":null,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('a check-out before the check-in is undetermined, never the four-hour floor', '{"shiftMin":480,"checkInMinFromStart":180,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":120}'::jsonb, '{"status":"undetermined","payableMin":null,"workedMin":null,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('a check-in past the end of the role section intersects nothing', '{"shiftMin":480,"checkInMinFromStart":510,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":540}'::jsonb, '{"status":"undetermined","payableMin":null,"workedMin":null,"floorApplied":false,"lateCheckOutFlag":false}'::jsonb),
  ('one worked minute still floors: the empty-window guard must not swallow RULE-14', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":1}'::jsonb, '{"status":"settled","payableMin":240,"workedMin":1,"floorApplied":true,"lateCheckOutFlag":false}'::jsonb);

create temporary table vec_turn_away (name text, input jsonb, expect jsonb) on commit drop;
insert into vec_turn_away (name, input, expect) values
  ('on time is a fixed four hours', '{"shiftMin":480,"attemptMinFromStart":10}'::jsonb, '{"payMin":240}'::jsonb),
  ('the last minute of the grace is still on time', '{"shiftMin":480,"attemptMinFromStart":29}'::jsonb, '{"payMin":240}'::jsonb),
  ('at start+30 the grace has elapsed and nothing is paid', '{"shiftMin":480,"attemptMinFromStart":30}'::jsonb, '{"payMin":0}'::jsonb),
  ('late is paid nothing', '{"shiftMin":480,"attemptMinFromStart":45}'::jsonb, '{"payMin":0}'::jsonb),
  ('arriving before the start is on time', '{"shiftMin":480,"attemptMinFromStart":-20}'::jsonb, '{"payMin":240}'::jsonb),
  ('four hours flat on a ten-hour shift', '{"shiftMin":600,"attemptMinFromStart":0}'::jsonb, '{"payMin":240}'::jsonb);

create temporary table vec_breaks (name text, input jsonb, expect jsonb) on commit drop;
insert into vec_breaks (name, input, expect) values
  ('a break inside the window is deducted in full', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":480,"breaks":[[180,200]]}'::jsonb, '{"unpaidBreakMin":20}'::jsonb),
  ('several breaks are summed', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":480,"breaks":[[120,140],[300,315]]}'::jsonb, '{"unpaidBreakMin":35}'::jsonb),
  ('a break before the scheduled start costs nothing', '{"shiftMin":480,"checkInMinFromStart":-30,"finishMinFromStart":480,"breaks":[[-25,-10]]}'::jsonb, '{"unpaidBreakMin":0}'::jsonb),
  ('a break straddling the start is clipped to the start', '{"shiftMin":480,"checkInMinFromStart":-30,"finishMinFromStart":480,"breaks":[[-10,10]]}'::jsonb, '{"unpaidBreakMin":10}'::jsonb),
  ('a break before a late check-in costs nothing past it', '{"shiftMin":480,"checkInMinFromStart":45,"finishMinFromStart":480,"breaks":[[40,60]]}'::jsonb, '{"unpaidBreakMin":15}'::jsonb),
  ('a break after the scheduled end costs nothing', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":540,"breaks":[[490,520]]}'::jsonb, '{"unpaidBreakMin":0}'::jsonb),
  ('a break straddling the end is clipped to the end', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":540,"breaks":[[470,500]]}'::jsonb, '{"unpaidBreakMin":10}'::jsonb),
  ('a break still running ends at the finish', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":300,"breaks":[[280,null]]}'::jsonb, '{"unpaidBreakMin":20}'::jsonb),
  ('a break still running is clipped to the end as well', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":600,"breaks":[[460,null]]}'::jsonb, '{"unpaidBreakMin":20}'::jsonb),
  ('a break past an early finish costs nothing', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":200,"breaks":[[210,230]]}'::jsonb, '{"unpaidBreakMin":0}'::jsonb),
  ('no breaks, nothing deducted', '{"shiftMin":480,"checkInMinFromStart":0,"finishMinFromStart":480,"breaks":[]}'::jsonb, '{"unpaidBreakMin":0}'::jsonb);
