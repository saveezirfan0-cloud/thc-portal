  ('the floor never inflates a shift already over four hours', '{"shiftMin":480,"checkInMinFromStart":0,"unpaidBreakMin":0,"leftEarlyViolation":false,"noCheckOut":"none","checkOutMinFromStart":480}'::jsonb, '{"status":"settled","payableMin":480,"workedMin":480,"floorApplied":false,"lateCheckOutFlag":false,"overrunMin":0}'::jsonb),
