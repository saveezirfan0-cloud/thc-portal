-- =====================================================================
-- Shared RLS fixtures for the pgTAP suite.
--
-- Included with \ir from every test file. The file deliberately uses the
-- .psql extension so that `supabase test db` (pg_prove --ext .pg --ext .sql)
-- does not try to run it as a test of its own.
--
-- Every row it creates is inside the caller's transaction and is rolled back
-- when the test finishes, so it can coexist with supabase/seed.sql. All
-- assertions address fixture rows by their fixed UUIDs, never by global
-- counts, for the same reason.
--
-- Roles are switched with the Supabase convention: set `request.jwt.claims`
-- so that auth.uid() resolves, then `set local role authenticated` (or anon)
-- so that RLS is actually enforced. `reset role` returns to the migration
-- role, which owns the tables and therefore bypasses RLS.
-- =====================================================================

-- ---- identities ----------------------------------------------------
\set admin_uid    '11111111-1111-1111-1111-111111111111'
\set clienta_uid  '22222222-2222-2222-2222-222222222222'
\set clientb_uid  '33333333-3333-3333-3333-333333333333'
\set staffa_uid   '44444444-4444-4444-4444-444444444444'
\set staffb_uid   '55555555-5555-5555-5555-555555555555'

-- ---- domain rows ---------------------------------------------------
\set clienta      'aaaaaaaa-0000-4000-8000-000000000001'
\set clientb      'aaaaaaaa-0000-4000-8000-000000000002'
\set role_id      'bbbbbbbb-0000-4000-8000-000000000001'
\set venue_id     'cccccccc-0000-4000-8000-000000000001'
\set ratecard_a   'cccccccc-0000-4000-8000-000000000002'
\set staffa       'dddddddd-0000-4000-8000-000000000001'
\set staffb       'dddddddd-0000-4000-8000-000000000002'
\set event_a      'eeeeeeee-0000-4000-8000-000000000001'
\set event_b      'eeeeeeee-0000-4000-8000-000000000002'
\set shift_a      'ffffffff-0000-4000-8000-000000000001'
\set shift_b      'ffffffff-0000-4000-8000-000000000002'
\set booking_a    '0a0a0a0a-0000-4000-8000-000000000001'
\set booking_b    '0a0a0a0a-0000-4000-8000-000000000002'
\set checklog_a   '0b0b0b0b-0000-4000-8000-000000000001'
\set checklog_b   '0b0b0b0b-0000-4000-8000-000000000002'
\set break_a      '0c0c0c0c-0000-4000-8000-000000000001'
\set break_b      '0c0c0c0c-0000-4000-8000-000000000002'
\set violation_a  '0d0d0d0d-0000-4000-8000-000000000001'
\set violation_b  '0d0d0d0d-0000-4000-8000-000000000002'
\set doc_a        '0e0e0e0e-0000-4000-8000-000000000001'
\set doc_b        '0e0e0e0e-0000-4000-8000-000000000002'
\set decl_a       '0f0f0f0f-0000-4000-8000-000000000001'
\set decl_b       '0f0f0f0f-0000-4000-8000-000000000002'
\set feedback_a   '1a1a1a1a-0000-4000-8000-000000000001'
\set feedback_b   '1a1a1a1a-0000-4000-8000-000000000002'
\set new_id       '9f9f9f9f-0000-4000-8000-00000000000f'

